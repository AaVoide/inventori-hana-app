<Window Icon="/InventoryApp;component/Assets/App.ico" x:Class="InventoryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventaris Aset" Height="760" Width="1240" MinWidth="1080" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>

        <!-- Baris atas -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Inventaris Aset" Style="{StaticResource Heading}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CurrentUserLabel}" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Cloud v0.4" Click="Cloud_Click" Margin="0,0,8,0"/>
                    <Button Content="Panduan" Click="Guide_Click" Margin="0,0,8,0"/>
                    <Button Content="Kata sandi" Click="Password_Click" Margin="0,0,8,0"/>
                    <Button Content="Ganti akun" Click="Logout_Click" Margin="0,0,8,0"/>
                    <Button Content="Tutup" Click="Exit_Click"/>                </StackPanel>
            </Grid>
        </Border>

        <!-- Baris bawah -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Sebelumnya" Command="{Binding PreviousPageCommand}" Margin="4,0"/>
                    <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="8,0"/>
                    <Button Content="Berikutnya" Command="{Binding NextPageCommand}" Margin="4,0"/>
                </StackPanel>
                <TextBlock Foreground="{StaticResource Muted}" Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="16,6" Background="#F0F4F6" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
            <WrapPanel>
                <Button Content="Buka Excel / CSV" Click="Import_Click" Margin="0,0,8,0"/>
                <Button Content="Ekspor Excel / CSV" Click="Export_Click" Margin="0,0,8,0"/>
                <Button Content="Data referensi" Click="MasterData_Click" Margin="0,0,8,0"/>
                <Button Content="Kelola akun" Click="Account_Click" Margin="0,0,8,0"/>
                <Button Content="Cadangan aman" Click="Backup_Click"/>
            </WrapPanel>
        </Border>
        <!-- Penyaring -->
        <Border DockPanel.Dock="Top" Padding="16,12,16,8">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="260" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="Keyword_KeyDown" ToolTip="Kode aset, nama barang, kode lama, atau ruangan"/>
                <Button Content="Cari" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Command="{Binding SearchCommand}"/>

                <ComboBox Width="180" Margin="16,0,0,0"
                          ItemsSource="{Binding Buildings}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedBuilding}"
                          ToolTip="Saring menurut gedung"/>
                <ComboBox Width="140" Margin="8,0,0,0"
                          ItemsSource="{Binding StatusFilters}"
                          ItemTemplate="{StaticResource StatusTemplate}"
                          SelectedItem="{Binding SelectedStatus}"/>
                <Button Content="Atur ulang" Style="{StaticResource QuietButton}" Margin="8,0,0,0"
                        Command="{Binding ClearFiltersCommand}"/>

                <Button Content="Tambah aset" Style="{StaticResource QuietButton}" Margin="24,0,0,0"
                        Click="AddAsset_Click" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Isi -->
        <Grid Margin="16,0,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Assets}"
                      SelectedItem="{Binding SelectedAsset}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kode Aset" Binding="{Binding AssetCode}" Width="110"/>
                    <DataGridTextColumn Header="Nama Barang" Binding="{Binding ItemTypeName}" Width="*" MinWidth="170"/>
                    <DataGridTextColumn Header="Lokasi" Binding="{Binding LocationDisplay}" Width="180"/>
                    <DataGridTextColumn Header="Kondisi" Binding="{Binding ConditionCode}" Width="70"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource DisplayText}}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Panel detail -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <!-- Kosong: belum ada yang dipilih -->
                    <TextBlock Text="{Binding EmptyDetailMessage}" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="24">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>

                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding SelectedAsset.AssetCode}" FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedAsset.ItemTypeName}" TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding SelectedAsset.CategoryName}"
                                       Foreground="{StaticResource Muted}"/>
                            <TextBlock Foreground="{StaticResource Muted}" Margin="0,2,0,0">
                                <Run Text="Kode lama: "/>
                                <Run Text="{Binding SelectedAsset.LegacyCode, Mode=OneWay, TargetNullValue=-}"/>
                            </TextBlock>
                            <Border Background="#F0F4F6" Padding="8,6" Margin="0,10,0,0">
                                <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                           Text="Kode Aset bersifat permanen dan tidak bisa diubah."/>
                            </Border>

                                                        <TextBlock Text="Gedung *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding EditBuildings}" DisplayMemberPath="Name" SelectedItem="{Binding EditBuilding}" IsEnabled="{Binding CanEdit}"/>
                            <TextBlock Text="Ruangan (opsional)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding EditRooms}" IsEnabled="{Binding CanEdit}" DisplayMemberPath="Display"
                                      SelectedItem="{Binding EditRoom}"/><Button Content="Tanpa ruangan" Click="ClearRoom_Click" HorizontalAlignment="Left" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Text="Kondisi" Style="{StaticResource FieldLabel}"/>
                            <ComboBox IsEnabled="{Binding CanEdit}" ItemsSource="{Binding EditConditions}" DisplayMemberPath="Display"
                                      SelectedItem="{Binding EditCondition}"/>

                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                            <ComboBox IsEnabled="{Binding CanEdit}" ItemsSource="{Binding StatusChoices}" SelectedItem="{Binding EditStatus}"
                                      ItemTemplate="{StaticResource StatusTemplate}"/>

                            <TextBlock Text="Tahun perolehan" Style="{StaticResource FieldLabel}"/>
                            <TextBox IsReadOnly="{Binding IsViewer}" Text="{Binding EditYear, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Keterangan" Style="{StaticResource FieldLabel}"/>
                            <TextBox IsReadOnly="{Binding IsViewer}" Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                     VerticalScrollBarVisibility="Auto"/>

                            <Button Content="Simpan perubahan" Style="{StaticResource PrimaryButton}"
                                    Margin="0,16,0,0" HorizontalAlignment="Right"
                                    Command="{Binding SaveCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Text="Riwayat perubahan" Style="{StaticResource FieldLabel}"
                                       Margin="0,20,0,6"/>
                            <TextBlock Text="{Binding SelectedAsset.UpdatedAt, StringFormat='Diperbarui: dd-MM-yyyy HH:mm:ss'}"
                                       Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding History}" Height="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Waktu" Width="115"
                                    Binding="{Binding ChangedAt, StringFormat='dd-MM-yyyy HH:mm'}"/>
                                <DataGridTextColumn Header="Oleh" Binding="{Binding UserName}" Width="90"/>
                                <DataGridTextColumn Header="Tindakan" Binding="{Binding Action, Converter={StaticResource DisplayText}}" Width="90"/>
                                <DataGridTextColumn Header="Kolom" Binding="{Binding FieldName, Converter={StaticResource DisplayText}}" Width="90"/>
                                <DataGridTextColumn Header="Dari" Binding="{Binding OldValue, Converter={StaticResource DisplayText}}" Width="120"/>
                                <DataGridTextColumn Header="Ke" Binding="{Binding NewValue, Converter={StaticResource DisplayText}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>



