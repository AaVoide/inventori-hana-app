<Window Icon="/InventoryApp;component/Assets/App.ico" x:Class="InventoryApp.Views.AddAssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah Aset" Height="740" Width="540" MinHeight="450" MinWidth="480"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Border Style="{StaticResource Card}" Margin="20">
        <StackPanel>
            <TextBlock Text="Tambah aset" Style="{StaticResource Heading}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="Satu jenis barang bisa menghasilkan banyak aset fisik. Isi jumlah sesuai banyaknya barang nyata; setiap barang mendapat Kode Aset sendiri."/>

            <TextBlock Text="1. Nama barang *" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="ItemTypeBox" DisplayMemberPath="Display" IsEditable="True" IsTextSearchEnabled="True"/>
            <Button Content="+ Nama barang baru" Click="NewItem_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
            <TextBlock Text="2. Gedung *" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="BuildingBox" DisplayMemberPath="Name" IsEditable="True" SelectionChanged="Building_Changed"/>
            <Button Content="+ Gedung baru" Click="NewBuilding_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
            <TextBlock Text="3. Ruangan (opsional)" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="RoomBox" DisplayMemberPath="Name" IsEditable="True"/>
            <WrapPanel><Button Content="Tanpa ruangan" Click="ClearRoom_Click" Margin="0,6,8,0"/><Button Content="+ Ruangan baru" Click="NewRoom_Click" Margin="0,6,0,0"/></WrapPanel>
            <TextBlock Text="4. Jumlah barang fisik *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="QuantityBox" Text="1"/>
            <Expander Header="Detail tambahan (opsional)" Margin="0,16,0,0"><StackPanel>
            <TextBlock Text="Kondisi" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="ConditionBox" DisplayMemberPath="Display"/>

            <TextBlock Text="Tahun perolehan" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="YearBox"/>

            <TextBlock Text="Keterangan" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NotesBox" Height="56" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel></Expander>
            <CheckBox x:Name="KeepOpen" Content="Lanjut tambah barang lain di lokasi yang sama" Margin="0,16,0,0"/>

            <TextBlock x:Name="ErrorText" Foreground="#B3261E" TextWrapping="Wrap"
                       Margin="0,12,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Batal" Style="{StaticResource QuietButton}" Click="Cancel_Click"
                        IsCancel="True"/>
                <Button Content="Buat aset" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Click="Create_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>

