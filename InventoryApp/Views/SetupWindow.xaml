<Window Icon="/InventoryApp;component/Assets/App.ico" x:Class="InventoryApp.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Persiapan awal — Inventaris Aset" Width="480" Height="590"
        MinWidth="420" MinHeight="480" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Margin="24">
            <StackPanel>
                <TextBlock Text="Selamat datang" Style="{StaticResource Heading}"/>
                <TextBlock Text="Buat akun admin pertama. Inventaris dimulai kosong; tambahkan data organisasi Anda setelah masuk."
                           TextWrapping="Wrap" Margin="0,8,0,12"/>
                <TextBlock Text="Nama lengkap" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="FullNameBox" MaxLength="100"/>
                <TextBlock Text="Nama pengguna (minimal 3 karakter)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UsernameBox" MaxLength="50"/>
                <TextBlock Text="Kata sandi (minimal 10 karakter)" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordBox"/>
                <TextBlock Text="Ulangi kata sandi" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="ConfirmBox"/>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#B3261E" Margin="0,12,0,0"/>
                <Button Content="Buat akun admin" Style="{StaticResource PrimaryButton}"
                        Margin="0,16,0,0" Click="Create_Click" IsDefault="True"/>
                <Button Content="Pulihkan cadangan aman (.hanaz / .hana)" Click="Restore_Click" Margin="0,12,0,0"/>
                <Button Content="Pulihkan cadangan otomatis (Windows yang sama)" Click="RestoreAutomatic_Click" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>



