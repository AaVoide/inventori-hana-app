<Application x:Class="InventoryApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:InventoryApp.Mvvm">
    <Application.Resources>
        <ResourceDictionary>
            <mvvm:DisplayTextConverter x:Key="DisplayText"/>
            <DataTemplate x:Key="StatusTemplate">
                <TextBlock Text="{Binding Converter={StaticResource DisplayText}}"/>
            </DataTemplate>

            <!-- Warna dasar: tenang, kontras cukup untuk layar kantor -->
            <SolidColorBrush x:Key="Ink"        Color="#1C2024"/>
            <SolidColorBrush x:Key="Muted"      Color="#6B7280"/>
            <SolidColorBrush x:Key="Line"       Color="#D8DCE0"/>
            <SolidColorBrush x:Key="Surface"    Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Canvas"     Color="#F3F5F7"/>
            <SolidColorBrush x:Key="Accent"     Color="#14607A"/>
            <SolidColorBrush x:Key="AccentDark" Color="#0E4A5E"/>

            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{StaticResource Canvas}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            </Style>

            <Style x:Key="Heading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                <Setter Property="Margin" Value="0,10,0,3"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="7,5"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="Background" Value="{StaticResource Surface}"/>
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Padding" Value="7,5"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="Background" Value="{StaticResource Surface}"/>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="7,5"/>
                <Setter Property="Background" Value="{StaticResource Surface}"/>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="16,7"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDark}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#9AA6AD"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource QuietButton}"/>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="RowHeight" Value="28"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#EDEFF2"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="CanUserAddRows" Value="False"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
